#!/usr/bin/env bash
# Install or restore the Koko-chan Navi desktop entry without touching Launcher2.

set -euo pipefail

desktop_dir="${XDG_DESKTOP_DIR:-${HOME}/Desktop}"
destination="${desktop_dir}/ココちゃんナビ.desktop"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
runner="${script_dir}/run_kokochan_navi_launcher2"

if [[ "${1:-}" == "--restore" ]]; then
    latest="$(find "${desktop_dir}" -maxdepth 1 -type f \
        -name 'ココちゃんナビ.desktop.backup.*' -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | head -1 | cut -d' ' -f2-)"
    if [[ -z "${latest}" ]]; then
        echo "No desktop backup found under ${desktop_dir}" >&2
        exit 2
    fi
    cp -- "${latest}" "${destination}"
    chmod +x "${destination}"
    echo "Restored ${destination} from ${latest}"
    exit 0
fi

if [[ ! -x "${runner}" ]]; then
    echo "Installed runner is not executable: ${runner}" >&2
    exit 2
fi
mkdir -p "${desktop_dir}"
if [[ -e "${destination}" ]]; then
    backup="${destination}.backup.$(date +%Y%m%d_%H%M%S)"
    cp -p -- "${destination}" "${backup}"
    echo "Backed up existing desktop entry: ${backup}"
fi

temporary="$(mktemp "${desktop_dir}/.kokochan_navi.desktop.XXXXXX")"
cleanup() { rm -f -- "${temporary}"; }
trap cleanup EXIT
cat >"${temporary}" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=ココちゃんナビ
Comment=Launcher2連携の読み取り専用ARナビを起動
Exec=${runner}
Terminal=false
StartupNotify=false
Categories=Utility;
EOF
chmod +x "${temporary}"
mv -- "${temporary}" "${destination}"
trap - EXIT
if command -v gio >/dev/null 2>&1; then
    gio set "${destination}" metadata::trusted true >/dev/null 2>&1 || true
fi
echo "Installed ${destination}"
echo "Runner: ${runner}"
echo "Restore: ${script_dir}/install_kokochan_navi_desktop --restore"
